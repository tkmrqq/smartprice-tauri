{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Права для главного окна и окна редактора категорий регулирования",
  "windows": ["main", "regulated-items"],
  "permissions": [
    "core:default",
    "core:window:allow-create",
    "core:webview:allow-create-webview-window",
    "core:event:allow-listen",
    "core:event:allow-emit",

    "dialog:allow-open",
    "dialog:allow-save",

    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-file",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPDATA/**" },
        { "path": "$HOME/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$PICTURE/**" },
        { "path": "$DESKTOP/**" }
      ]
    },

    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",

    "store:default",
    "store:allow-get",
    "store:allow-set",
    "store:allow-save",
    "store:allow-delete",
    "store:allow-load",

    {
      "identifier": "http:default",
      "allow": [{ "url": "https://vision.googleapis.com/*" }]
    }
  ]
}
